  "findings": [
    {
      "finding": "Trust-aware detection substantially improved attack detection on the benchmark dataset.",
      "evidence": "Recall increased from 50.00% to 100.00%."
    },
    {
      "finding": "Trust-aware detection reduced false negatives on the evaluated benchmark events.",
      "evidence": "False negatives decreased from 12 to 0."
    },
    {
      "finding": "Poisoned evidence received lower trust than clean evidence.",
      "evidence": "Average poisoned trust was 86.17, compared with 98.75 for clean evidence."
    },
    {
      "finding": "The unified-events endpoint showed higher latency under concurrent load.",
      "evidence": "The scalability benchmark recorded increasing latency as concurrency increased."
    },
    {
      "finding": "The dashboard summary endpoint is the main measured API latency bottleneck.",
      "evidence": "Its average latency was substantially higher than the other tested endpoints."
    },
    {
      "finding": "The API remained reliable under the tested sequential and concurrent workloads.",
      "evidence": "All measured scalability and reliability requests succeeded."
    }
  ],
  "limitations": [
    "The benchmark dataset is synthetic data generated locally.",
    "The results do not establish performance on unseen real-world healthcare data.",
    "The trust-aware and scenario-correlation rules were developed around the generated attack scenarios.",
    "The 100% trust-aware detection result should therefore not be interpreted as guaranteed generalisation.",
    "API measurements were performed on the local development environment rather than production cloud infrastructure.",
    "The dashboard summary endpoint exhibited substantially higher latency than the other measured endpoints."
  ]
}